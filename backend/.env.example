# ==============================================================================
# Roxstar AI Voice Room — Backend Environment Configuration
# Copy this file to .env and configure your production credentials.
# NEVER commit real .env files to source control.
# ==============================================================================

# ── LiveKit Cloud Realtime Infrastructure ─────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Upstash Redis Distributed State & Locks ──────────────────────────────────
# Local dev: redis://localhost:6379/0
# Upstash:   rediss://default:<password>@<host>.upstash.io:6379/0
REDIS_URL=rediss://default:your-redis-password@your-upstash-host.upstash.io:6379/0
REDIS_PASSWORD=
REDIS_TLS=true

# ── STT (Speech-to-Text) Provider ─────────────────────────────────────────────
# Primary: Deepgram Nova-3 multilingual model
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── LLM (Language Model) Provider ─────────────────────────────────────────────
# Active & Primary: Groq ultra-low-latency voice inference
LLM_PROVIDER=groq
LLM_MODEL=groq/compound-mini
GROQ_API_KEY=your_groq_api_key_here

# ── TTS (Text-to-Speech) Provider ─────────────────────────────────────────────
# Primary: ElevenLabs Flash v2.5 with Hindi neural voices
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DOST_VOICE_ID=your_dost_male_hindi_voice_id
SATHI_VOICE_ID=your_sathi_female_hindi_voice_id

# ── Token Server & Networking ────────────────────────────────────────────────
PORT=8000
TOKEN_SERVER_PORT=8000
TOKEN_TTL_SECONDS=3600
# Comma-separated list of allowed origins, or * for public CORS
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
