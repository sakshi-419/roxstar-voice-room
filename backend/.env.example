# ──────────────────────────────────────────────────────────────────────────────
# Roxstar AI Voice Room — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── LiveKit Cloud ─────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev:  redis://localhost:6379/0
# Upstash:    rediss://default:<password>@<host>:6380/0
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_TLS=false

# ── STT ───────────────────────────────────────────────────────────────────────
# Supported: deepgram | google_stt
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM ───────────────────────────────────────────────────────────────────────
# Supported: google | openai
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only required when LLM_PROVIDER=openai:
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── TTS ───────────────────────────────────────────────────────────────────────
# Supported: elevenlabs | google_tts
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ElevenLabs voice IDs — evaluate Hindi voices and paste chosen IDs below
DOST_VOICE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
SATHI_VOICE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Token Server ──────────────────────────────────────────────────────────────
TOKEN_SERVER_PORT=8000
TOKEN_TTL_SECONDS=3600

# ── Logging ───────────────────────────────────────────────────────────────────
# Supported: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
