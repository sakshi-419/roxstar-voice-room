# ==============================================================================
# Roxstar AI Voice Room — Root Environment Template
# NEVER commit real .env files to version control.
# ==============================================================================

# ── Backend & LiveKit Worker ──────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

REDIS_URL=rediss://default:your-password@your-host.upstash.io:6379/0

DEEPGRAM_API_KEY=your_deepgram_api_key

LLM_PROVIDER=groq
LLM_MODEL=groq/compound-mini
GROQ_API_KEY=your_groq_api_key

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key
DOST_VOICE_ID=your_dost_voice_id
SATHI_VOICE_ID=your_sathi_voice_id

CORS_ORIGINS=*
PORT=8000
LOG_LEVEL=INFO

# ── Frontend (Vercel) ─────────────────────────────────────────────────────────
# In production, point this to your deployed Token Server URL
VITE_TOKEN_SERVER_URL=https://your-token-server.onrender.com
